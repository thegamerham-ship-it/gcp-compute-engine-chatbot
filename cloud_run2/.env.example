# ==============================================================================
# Google Cloud ADC (Application Default Credentials) Environment Configuration
# ==============================================================================
# Cloud Run 환경에서는 서비스 계정(IAM)과 메타데이터 서버를 통해 ADC가 자동 주입됩니다.
# 로컬 개발 시에는 아래 명령어로 ADC 로그인 후 본 설정을 사용하세요:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project iceu-songpa21

GOOGLE_CLOUD_PROJECT=iceu-songpa21
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# 서버 포트 및 호스트 설정 (Cloud Run 기본 포트: 8080)
HOST=0.0.0.0
PORT=8080
